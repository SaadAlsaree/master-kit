<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>

    <!-- Version Variables for Consistency -->
    <AspnetVersion>10.0.14</AspnetVersion>
    <MicrosoftExtensionsVersion>10.11.0</MicrosoftExtensionsVersion>
    <MicrosoftExtensionsHttpResilienceVersion>10.11.0</MicrosoftExtensionsHttpResilienceVersion>
    <GrpcVersion>2.85.0</GrpcVersion>
    <OpenTelemetryVersion>1.20.1</OpenTelemetryVersion>
    <FluentValidationVersion>12.2.0</FluentValidationVersion>
    <WolverineVersion>6.57.0</WolverineVersion>
    <MapsterVersion>10.0.13</MapsterVersion>
    <NpgsqlEfVersion>10.0.3</NpgsqlEfVersion>
    <RefitVersion>16.4.0</RefitVersion>
  </PropertyGroup>
  <ItemGroup>
  
    <!-- ASP.NET & Microsoft Extensions (NET 10) -->
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="$(AspnetVersion)" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="$(AspnetVersion)" />
    <PackageVersion Include="Microsoft.Extensions.ApiDescription.Server" Version="$(AspnetVersion)">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageVersion>
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="$(AspnetVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="$(MicrosoftExtensionsHttpResilienceVersion)" />
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery" Version="$(MicrosoftExtensionsVersion)" />
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery.Yarp" Version="$(MicrosoftExtensionsVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="$(AspnetVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="$(AspnetVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="$(AspnetVersion)" />
    <!-- Keep 2.x — required by Microsoft.AspNetCore.OpenApi 10.x -->
    <PackageVersion Include="Microsoft.OpenApi" Version="2.13.0" />

    <!-- Entity Framework & Database (PostgreSQL / Pgvector) -->
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="$(NpgsqlEfVersion)" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="$(AspnetVersion)" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="$(AspnetVersion)" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="$(AspnetVersion)" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Tools" Version="$(AspnetVersion)" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="$(AspnetVersion)" />
    <PackageVersion Include="Pgvector" Version="0.3.2" />
    <PackageVersion Include="Pgvector.EntityFrameworkCore" Version="0.3.0" />

    <!-- API Versioning -->
    <PackageVersion Include="Asp.Versioning.Http" Version="10.2.3" />
    <PackageVersion Include="Asp.Versioning.Http.Client" Version="10.2.0" />
    <PackageVersion Include="Asp.Versioning.Mvc.ApiExplorer" Version="10.2.1" />
    <PackageVersion Include="Asp.Versioning.OpenApi" Version="10.2.3" />

    <!-- Health Checks -->
    <PackageVersion Include="AspNetCore.HealthChecks.Uris" Version="9.0.0" />

    <!-- OpenTelemetry Observability -->
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="$(OpenTelemetryVersion)" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="$(OpenTelemetryVersion)" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="$(OpenTelemetryVersion)" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.GrpcNetClient" Version="1.20.1-beta.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="$(OpenTelemetryVersion)" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="$(OpenTelemetryVersion)" />

    <!-- gRPC -->
    <PackageVersion Include="Grpc.AspNetCore" Version="$(GrpcVersion)" />
    <PackageVersion Include="Grpc.Net.ClientFactory" Version="$(GrpcVersion)" />
    <PackageVersion Include="Grpc.Tools" Version="$(GrpcVersion)" PrivateAssets="All" />
    <PackageVersion Include="Google.Protobuf" Version="3.36.2" />

    <!-- Code Generation & Scaffolding (.NET 10) -->
    <PackageVersion Include="Microsoft.VisualStudio.Web.CodeGeneration.Design" Version="10.0.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageVersion>
    <PackageVersion Include="Microsoft.Web.LibraryManager.Build" Version="3.0.114" />

    <!-- Testing Frameworks -->
    <PackageVersion Include="MSTest" Version="4.5.2" />
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="$(MicrosoftExtensionsVersion)" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <PackageVersion Include="NSubstitute.Analyzers.CSharp" Version="1.0.17" />

    <!-- Static Code Analyzers -->
    <PackageVersion Include="SonarAnalyzer.CSharp" Version="10.35.0.4138" />
    <PackageVersion Include="StyleCop.Analyzers" Version="1.2.0-beta.556" />

    <!-- WolverineFx Ecosystem -->
    <PackageVersion Include="WolverineFx" Version="$(WolverineVersion)" />
    <PackageVersion Include="WolverineFx.FluentValidation" Version="$(WolverineVersion)" />
    <PackageVersion Include="WolverineFx.Http" Version="$(WolverineVersion)" />
    <PackageVersion Include="WolverineFx.Http.FluentValidation" Version="$(WolverineVersion)" />
    <PackageVersion Include="WolverineFx.RabbitMQ" Version="$(WolverineVersion)" />
    <PackageVersion Include="WolverineFx.EntityFrameworkCore" Version="$(WolverineVersion)" />
    <PackageVersion Include="WolverineFx.Postgresql" Version="$(WolverineVersion)" />
    <PackageVersion Include="WolverineFx.RuntimeCompilation" Version="$(WolverineVersion)" />

    <!-- Utilities & Libraries -->
    <PackageVersion Include="Dapper" Version="2.1.89" />
    <PackageVersion Include="FluentValidation" Version="$(FluentValidationVersion)" />
    <PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="$(FluentValidationVersion)" />
    <PackageVersion Include="Polly" Version="8.9.0" />
    <PackageVersion Include="System.Linq.Dynamic.Core" Version="1.7.4" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="5.0.0" />
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageVersion Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageVersion Include="System.Reflection.TypeExtensions" Version="4.7.0" />
    <PackageVersion Include="IdentityModel" Version="7.0.0" />
    <PackageVersion Include="Scalar.AspNetCore" Version="2.18.5" />
    <PackageVersion Include="Meilisearch" Version="0.20.0" />
    <PackageVersion Include="Minio" Version="7.0.0" />
    <!-- Inter-Service Communication (Refit) -->
    <PackageVersion Include="Refit" Version="$(RefitVersion)" />
    <PackageVersion Include="Refit.HttpClientFactory" Version="$(RefitVersion)" />
    <!-- Object Mapping (Mapster) -->
    <PackageVersion Include="Mapster" Version="$(MapsterVersion)" />
    <PackageVersion Include="Mapster.DependencyInjection" Version="$(MapsterVersion)" />
  </ItemGroup>
</Project>
